# Copy this file to .env and fill in your Kaggle credentials.
#
#   cp .env.example .env
#
# Where to get these:
#   1. Sign in at https://www.kaggle.com
#   2. Click your avatar -> Settings
#   3. Scroll to the "API" section -> "Create New Token"
#   4. A kaggle.json file downloads. Open it; it looks like:
#        {"username":"yourname","key":"0123456789abcdef0123456789abcdef"}
#   5. Copy those two values below.
#
# .env is gitignored. Never commit your key.

KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
